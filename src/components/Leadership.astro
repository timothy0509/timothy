---
import SectionReveal from "./SectionReveal.astro";

const roles = [
  {
    title: "Study Prefect",
    period: "2025–2026",
    description:
      "Academic leadership role supporting student discipline, peer mentoring, and school initiatives.",
    icon: "prefect",
  },
  {
    title: "Secretary, Gardening Club",
    period: "2025–2026",
    description:
      "Managing club administration, meeting records, event coordination, and internal communications.",
    icon: "secretary",
  },
  {
    title: "Treasurer, Computer Club",
    period: "2025–2026",
    description:
      "Overseeing club finances, budgeting for equipment and activities, and fiscal reporting.",
    icon: "treasurer",
  },
];

const iconPaths: Record<string, string> = {
  prefect:
    "M12 14l9-5-9-5-9 5 9 5zM12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z",
  secretary:
    "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  treasurer:
    "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
};
---

<section
  class="py-24 md:py-32 bg-surface/50 dark:bg-surface-dark/30"
>
  <div class="section-container">
    <SectionReveal>
      <div class="accent-line"></div>
      <h2 class="section-title">Leadership</h2>
      <p class="section-subtitle">Extracurricular roles and responsibilities</p>
    </SectionReveal>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        roles.map((role, i) => (
          <SectionReveal delay={i + 1}>
            <div class="card group h-full">
              <div class="flex items-start gap-4 mb-4">
                <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent/10 dark:bg-accent/15 shrink-0">
                  <svg
                    class="w-5 h-5 text-accent dark:text-accent-lighter"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={iconPaths[role.icon]} />
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading text-lg font-semibold text-text dark:text-text-dark">
                    {role.title}
                  </h3>
                  <p class="text-xs font-medium text-accent dark:text-accent-lighter">
                    {role.period}
                  </p>
                </div>
              </div>
              <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">
                {role.description}
              </p>
            </div>
          </SectionReveal>
        ))
      }
    </div>
  </div>
</section>
