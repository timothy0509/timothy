---
import SectionReveal from "./SectionReveal.astro";

const achievements = [
  {
    title: "Gold Award",
    event: "HKCERT 2025 CTF",
    description:
      "Awarded gold in Hong Kong's premier cybersecurity capture-the-flag competition.",
    icon: "gold",
  },
  {
    title: "Champion",
    event: "Firebird Open CTF Competition 2026",
    description:
      "First place finish, demonstrating top-tier problem-solving and security skills.",
    icon: "champion",
  },
  {
    title: "First Runner Up",
    event: "PolyU x NuttyShell Cybersecurity CTF 2026",
    description:
      "Second place in a university-level cybersecurity competition.",
    icon: "silver",
  },
];
---

<section id="achievements" class="py-24 md:py-32 bg-surface/50 dark:bg-surface-dark/30">
  <div class="section-container">
    <SectionReveal>
      <div class="accent-line"></div>
      <h2 class="section-title">Achievements</h2>
      <p class="section-subtitle">Competition results and recognition</p>
    </SectionReveal>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        achievements.map((a, i) => (
          <SectionReveal delay={i + 1}>
            <div class="card group h-full">
              <div class="flex items-start gap-4 mb-4">
                <div
                  class:list={[
                    "flex items-center justify-center w-12 h-12 rounded-xl shrink-0",
                    {
                      "bg-yellow-100 dark:bg-yellow-900/30": a.icon === "gold",
                      "bg-amber-100 dark:bg-amber-900/30":
                        a.icon === "champion",
                      "bg-slate-100 dark:bg-slate-800": a.icon === "silver",
                    },
                  ]}
                >
                  {a.icon === "gold" && (
                    <svg
                      class="w-6 h-6 text-yellow-500"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  )}
                  {a.icon === "champion" && (
                    <svg
                      class="w-6 h-6 text-amber-500"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  )}
                  {a.icon === "silver" && (
                    <svg
                      class="w-6 h-6 text-slate-400"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  )}
                </div>
                <div>
                  <h3 class="font-heading text-xl font-semibold text-text dark:text-text-dark">
                    {a.title}
                  </h3>
                  <p class="text-sm font-medium text-accent dark:text-accent-lighter">
                    {a.event}
                  </p>
                </div>
              </div>
              <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">
                {a.description}
              </p>
            </div>
          </SectionReveal>
        ))
      }
    </div>
  </div>
</section>
