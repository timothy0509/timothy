---
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-1/4 -left-32 w-96 h-96 rounded-full opacity-[0.03] dark:opacity-[0.05]"
      style="background: radial-gradient(circle, var(--color-accent), transparent 70%)"
    >
    </div>
    <div
      class="absolute bottom-1/4 -right-32 w-80 h-80 rounded-full opacity-[0.03] dark:opacity-[0.05]"
      style="background: radial-gradient(circle, var(--color-accent-light), transparent 70%)"
    >
    </div>
  </div>

  <div class="section-container relative z-10 text-center">
    <div class="reveal" data-reveal>
      <p
        class="text-sm font-medium tracking-widest uppercase text-accent dark:text-accent-lighter mb-6"
      >
        Student Developer & Cybersecurity Enthusiast
      </p>
    </div>

    <div class="reveal reveal-delay-1" data-reveal>
      <h1
        class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-semibold tracking-tight mb-6 text-text dark:text-text-dark"
      >
        Timothy
        <span
          class="block bg-gradient-to-r from-accent to-accent-light bg-clip-text text-transparent"
        >
          Wong
        </span>
      </h1>
    </div>

    <div class="reveal reveal-delay-2" data-reveal>
      <p
        class="text-lg md:text-xl text-muted dark:text-muted-dark max-w-2xl mx-auto mb-10 leading-relaxed"
      >
        Building reliable systems, competing in CTFs, and exploring the
        intersection of software, infrastructure, and security — based in Hong
        Kong.
      </p>
    </div>

    <div class="reveal reveal-delay-3 flex items-center justify-center gap-4" data-reveal>
      <a
        href="#projects"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent hover:bg-accent-hover text-white font-medium text-sm transition-all duration-300 hover:shadow-lg hover:shadow-accent/20"
      >
        View Projects
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-light text-text dark:text-text-dark font-medium text-sm transition-all duration-300"
      >
        Get in Touch
      </a>
    </div>

    <div class="reveal reveal-delay-4 mt-16" data-reveal>
      <div class="flex items-center justify-center gap-6">
        <a
          href="https://github.com/timothy0509"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="text-muted dark:text-muted-dark hover:text-text dark:hover:text-text-dark transition-colors duration-200"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/timothy-wong-531a6b2ba/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-muted dark:text-muted-dark hover:text-text dark:hover:text-text-dark transition-colors duration-200"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg
      class="w-5 h-5 text-muted dark:text-muted-dark"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
